# Copy to .env and source it in every terminal on the robot.
# No real addresses are stored in this repository.

# GR00T policy server (GPU server)
POLICY_HOST=policy-server.example
POLICY_PORT=5555

# Robot-side services
ROBOT_HOST=localhost
CAMERA_PORT=5555
KEYBOARD_PORT=5580

# Network interface the BrainCo hand DDS channel uses on the robot, e.g. the
# name printed by `ip link` for the interface on the robot network
HAND_IFACE=

# Mode-selection VLM service (GPU server), optional
VLM_HOST=policy-server.example
VLM_PORT=5599

# Supervisor
AGENT_HAND=left
AGENT_LOG_DIR=agent_logs
